import threading
import time
import tkinter as tk
from tkinter import messagebox, ttk

import snap7
from snap7 import util

# ---------- Config ----------
# ✅ เปลี่ยน IP เดิมให้เป็นค่าเริ่มต้นแทน
DEFAULT_PLC_IP = "192.168.200.213"
RACK = 0
SLOT = 1

DB_NUMBER = 26
INT_COUNT = 16
START_ADDRESS = 0
SIZE = INT_COUNT * 2

# Markers (ตาม Ladder)
M_BASE = 150
M_HMI_SENT_BIT = 0
M_INT_SENT_BIT = 1
INT_SENT_HOLD_SECONDS = 5.0


# ---------- Helper (read/write M bytes) ----------
def read_m_byte(client, byte_addr: int) -> bytearray:
    return client.mb_read(byte_addr, 1)


def write_m_byte(client, byte_addr: int, data: bytearray) -> None:
    client.mb_write(byte_addr, len(data), data)


class PlcApp:
    def __init__(self, root):
        self.root = root
        self.root.title("PLC Control Panel")
        self.root.geometry("520x720")

        self.client = snap7.client.Client()
        self.is_connected = False
        self.is_running = True
        self._lock = threading.Lock()

        self._build_ui()

        self.read_thread = threading.Thread(target=self._periodic_read, daemon=True)
        self.read_thread.start()

        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

    # ---------- UI ----------
    def _build_ui(self):
        # Connection
        fr_conn = ttk.LabelFrame(self.root, text="Connection")
        fr_conn.pack(padx=10, pady=8, fill="x")

        # ✅ --- ส่วนของ IP Address ที่เพิ่มเข้ามา ---
        fr_ip = tk.Frame(fr_conn)
        fr_ip.pack(fill="x", padx=5, pady=(8, 4))
        ttk.Label(fr_ip, text="PLC IP Address:").pack(side="left")
        self.entry_ip = ttk.Entry(fr_ip, width=20)
        self.entry_ip.pack(side="left", padx=6)
        self.entry_ip.insert(0, DEFAULT_PLC_IP)  # ใส่ค่าเริ่มต้น
        # --- จบส่วนที่เพิ่ม ---

        fr_buttons = tk.Frame(fr_conn)
        fr_buttons.pack(fill="x", padx=5, pady=(0, 6))

        self.btn_connect = ttk.Button(
            fr_buttons, text="Connect", command=self.connect_plc
        )
        self.btn_connect.pack(side="left", padx=0)

        self.btn_disconnect = ttk.Button(
            fr_buttons, text="Disconnect", command=self.disconnect_plc, state="disabled"
        )
        self.btn_disconnect.pack(side="left", padx=5)

        self.lbl_status = ttk.Label(
            fr_buttons, text="Status: Disconnected", foreground="red"
        )
        self.lbl_status.pack(side="left", padx=12)

        # (ส่วน UI ที่เหลือเหมือนเดิม)
        fr_m = ttk.LabelFrame(self.root, text="Markers (%M150.x)")
        fr_m.pack(padx=10, pady=6, fill="x")
        row = tk.Frame(fr_m)
        row.pack(fill="x", padx=6, pady=6)
        ttk.Label(row, text="%M150.0  HMI SENT DATA: ").pack(side="left")
        self.lbl_m150_0 = ttk.Label(
            row,
            text="OFF",
            width=5,
            anchor="center",
            background="#fee",
            relief="groove",
        )
        self.lbl_m150_0.pack(side="left", padx=6)
        row2 = tk.Frame(fr_m)
        row2.pack(fill="x", padx=6, pady=6)
        ttk.Label(row2, text="%M150.1  Int_Sent Data: ").pack(side="left")
        self.lbl_m150_1 = ttk.Label(
            row2,
            text="OFF",
            width=5,
            anchor="center",
            background="#fee",
            relief="groove",
        )
        self.lbl_m150_1.pack(side="left", padx=6)
        fr_act = ttk.LabelFrame(self.root, text="Actions")
        fr_act.pack(padx=10, pady=6, fill="x")
        self.btn_pulse_hmi = ttk.Button(
            fr_act,
            text="▶ Pulse  %M150.0  (HMI SENT DATA)",
            command=self._pulse_hmi_thread,
            state="disabled",
        )
        self.btn_pulse_hmi.pack(fill="x", padx=6, pady=6)
        self.btn_hold_int = ttk.Button(
            fr_act,
            text=f"▶ Hold %M150.1  (Int_Sent Data) {INT_SENT_HOLD_SECONDS:.0f}s",
            command=self._hold_int_sent_thread,
            state="disabled",
        )
        self.btn_hold_int.pack(fill="x", padx=6, pady=(0, 6))
        self.btn_reload = ttk.Button(
            fr_act,
            text="🔄 Reload DB26 → GUI",
            command=self.read_db_to_gui,
            state="disabled",
        )
        self.btn_reload.pack(fill="x", padx=6, pady=(6, 6))
        self.btn_write = ttk.Button(
            fr_act,
            text="⬆ Write GUI → DB26",
            command=self.write_gui_to_db,
            state="disabled",
        )
        self.btn_write.pack(fill="x", padx=6, pady=(0, 6))
        fr_db = ttk.LabelFrame(
            self.root, text=f"Data_Center [DB{DB_NUMBER}]  Int[0..{INT_COUNT-1}]"
        )
        fr_db.pack(padx=10, pady=8, fill="both", expand=True)
        canvas = tk.Canvas(fr_db)
        vsb = ttk.Scrollbar(fr_db, orient="vertical", command=canvas.yview)
        self.frm_scroll = ttk.Frame(canvas)
        self.frm_scroll.bind(
            "<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        canvas.create_window((0, 0), window=self.frm_scroll, anchor="nw")
        canvas.configure(yscrollcommand=vsb.set)
        canvas.pack(side="left", fill="both", expand=True)
        vsb.pack(side="right", fill="y")
        self.entry_widgets = []
        for i in range(INT_COUNT):
            ttk.Label(self.frm_scroll, text=f"Data_Center[{i}] (offset {i*2}):").grid(
                row=i, column=0, sticky="w", padx=8, pady=4
            )
            ent = ttk.Entry(self.frm_scroll, width=18)
            ent.grid(row=i, column=1, sticky="w", padx=(4, 16), pady=4)
            self.entry_widgets.append(ent)

    # ---------- Connect/Disconnect ----------
    def connect_plc(self):
        # ✅ อ่านค่า IP จากช่องกรอก
        plc_ip_to_connect = self.entry_ip.get().strip()
        if not plc_ip_to_connect:
            messagebox.showwarning("Input Error", "กรุณากรอก IP Address ของ PLC")
            return

        try:
            with self._lock:
                # ✅ ใช้ IP ที่อ่านได้ในการเชื่อมต่อ
                self.client.connect(plc_ip_to_connect, RACK, SLOT)
                self.is_connected = True

            self._ui_connected(True)
            self.read_db_to_gui()
        except Exception as e:
            messagebox.showerror("Connection Error", f"เชื่อมต่อ PLC ไม่สำเร็จ:\n{e}")

    def disconnect_plc(self):
        try:
            with self._lock:
                if self.is_connected:
                    self.client.disconnect()
                self.is_connected = False
        except Exception:
            pass
        self._ui_connected(False)

    def _ui_connected(self, ok: bool):
        if ok:
            self.lbl_status.config(text="Status: Connected", foreground="green")
            self.btn_connect.config(state="disabled")
            self.btn_disconnect.config(state="normal")
            self.btn_write.config(state="normal")
            self.btn_reload.config(state="normal")
            self.btn_pulse_hmi.config(state="normal")
            self.btn_hold_int.config(state="normal")
            self.entry_ip.config(state="disabled")  # ✅ ล็อกช่องกรอก IP
        else:
            self.lbl_status.config(text="Status: Disconnected", foreground="red")
            self.btn_connect.config(state="normal")
            self.btn_disconnect.config(state="disabled")
            self.btn_write.config(state="disabled")
            self.btn_reload.config(state="disabled")
            self.btn_pulse_hmi.config(state="disabled")
            self.btn_hold_int.config(state="disabled")
            self.entry_ip.config(state="normal")  # ✅ ปลดล็อกช่องกรอก IP
            self._update_marker_labels(False, False)

    # (ส่วนที่เหลือของโค้ดเหมือนเดิมทั้งหมด)
    def _periodic_read(self):
        while self.is_running:
            if self.is_connected:
                try:
                    with self._lock:
                        buf = read_m_byte(self.client, M_BASE)
                    m0 = util.get_bool(buf, 0, M_HMI_SENT_BIT)
                    m1 = util.get_bool(buf, 0, M_INT_SENT_BIT)
                    self.root.after(
                        0, lambda m0=m0, m1=m1: self._update_marker_labels(m0, m1)
                    )
                except Exception:
                    self.root.after(0, self.disconnect_plc)
            time.sleep(0.5)

    def _update_marker_labels(self, m0: bool, m1: bool):
        self.lbl_m150_0.config(
            text="ON" if m0 else "OFF", background="#efe" if m0 else "#fee"
        )
        self.lbl_m150_1.config(
            text="ON" if m1 else "OFF", background="#efe" if m1 else "#fee"
        )

    def _read_db_values(self):
        with self._lock:
            data = self.client.db_read(DB_NUMBER, START_ADDRESS, SIZE)
        vals = [util.get_int(data, i * 2) for i in range(INT_COUNT)]
        return vals

    def _write_db_values(self, values):
        data = bytearray(SIZE)
        for i, v in enumerate(values):
            util.set_int(data, i * 2, int(v))
        with self._lock:
            self.client.db_write(DB_NUMBER, START_ADDRESS, data)

    def read_db_to_gui(self):
        if not self.is_connected:
            return
        try:
            vals = self._read_db_values()

            def fill():
                for i, v in enumerate(vals):
                    if self.root.focus_get() != self.entry_widgets[i]:
                        self.entry_widgets[i].delete(0, tk.END)
                        self.entry_widgets[i].insert(0, str(v))

            self.root.after(0, fill)
        except Exception as e:
            print("Read DB error:", e)
            self.disconnect_plc()

    def write_gui_to_db(self):
        if not self.is_connected:
            return
        try:
            vals = []
            for i, ent in enumerate(self.entry_widgets):
                txt = ent.get().strip() or "0"
                try:
                    v = int(txt)
                except ValueError:
                    raise ValueError(f"ช่องที่ {i}: ต้องเป็นจำนวนเต็ม (ได้ “{txt}”)")
                if v < -32768 or v > 32767:
                    raise ValueError(f"ช่องที่ {i}: ต้องอยู่ในช่วง -32768..32767")
                vals.append(v)
            self._write_db_values(vals)
            messagebox.showinfo("Success", "เขียน DB26 สำเร็จ")
        except Exception as e:
            messagebox.showerror("Write Error", f"เกิดข้อผิดพลาด: {e}")

    def _pulse_hmi_thread(self):
        threading.Thread(target=self._pulse_hmi, daemon=True).start()

    def _pulse_hmi(self):
        if not self.is_connected:
            return
        try:
            self.root.after(0, lambda: self.btn_pulse_hmi.config(state="disabled"))
            with self._lock:
                buf = read_m_byte(self.client, M_BASE)
            util.set_bool(buf, 0, M_HMI_SENT_BIT, True)
            with self._lock:
                write_m_byte(self.client, M_BASE, buf)
            time.sleep(0.5)
            with self._lock:
                buf2 = read_m_byte(self.client, M_BASE)
            util.set_bool(buf2, 0, M_HMI_SENT_BIT, False)
            with self._lock:
                write_m_byte(self.client, M_BASE, buf2)
            self.root.after(
                0, lambda: messagebox.showinfo("Success", "Pulse %M150.0 เรียบร้อย")
            )
        except Exception as e:
            msg = f"เกิดข้อผิดพลาด: {e}"
            self.root.after(0, lambda m=msg: messagebox.showerror("Trigger Error", m))
        finally:
            if self.is_connected:
                self.root.after(0, lambda: self.btn_pulse_hmi.config(state="normal"))

    def _hold_int_sent_thread(self):
        threading.Thread(target=self._hold_int_sent, daemon=True).start()

    def _hold_int_sent(self):
        if not self.is_connected:
            return
        try:
            self.root.after(0, lambda: self.btn_hold_int.config(state="disabled"))
            with self._lock:
                buf = read_m_byte(self.client, M_BASE)
            util.set_bool(buf, 0, M_INT_SENT_BIT, True)
            with self._lock:
                write_m_byte(self.client, M_BASE, buf)
            time.sleep(max(0.1, float(INT_SENT_HOLD_SECONDS)))
            with self._lock:
                buf2 = read_m_byte(self.client, M_BASE)
            util.set_bool(buf2, 0, M_INT_SENT_BIT, False)
            with self._lock:
                write_m_byte(self.client, M_BASE, buf2)
            self.root.after(
                0,
                lambda: messagebox.showinfo(
                    "Success", f"Hold %M150.1 {INT_SENT_HOLD_SECONDS:.0f}s สำเร็จ"
                ),
            )
        except Exception as e:
            msg = f"เกิดข้อผิดพลาด: {e}"
            self.root.after(0, lambda m=msg: messagebox.showerror("Trigger Error", m))
        finally:
            if self.is_connected:
                self.root.after(0, lambda: self.btn_hold_int.config(state="normal"))

    def on_close(self):
        self.is_running = False
        time.sleep(0.1)
        self.disconnect_plc()
        self.root.destroy()


if __name__ == "__main__":
    try:
        from snap7.types import Areas

        print("INFO: snap7.types available (เราไม่ได้ใช้ Areas เพื่อกันเวอร์ชัน).")
    except Exception:
        print("WARNING: snap7.types not found. Running Legacy-Compatible mode.")
    root = tk.Tk()
    app = PlcApp(root)
    root.mainloop()
